diff --git a/hw/misc/pebble_wasm.c b/hw/misc/pebble_wasm.c
new file mode 100644
index 0000000..54a045f
--- /dev/null
+++ b/hw/misc/pebble_wasm.c
@@ -0,0 +1,208 @@
+/* Browser bridges. All device callbacks run on QEMU's timer thread, while
+ * the browser only publishes/consumes shared-memory data using Atomics.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include "qemu/atomic.h"
+#include "qemu/timer.h"
+#include "ui/console.h"
+#include "hw/arm/pebble_gpio.h"
+#include "hw/arm/pebble_wasm.h"
+
+#define SERIAL_SIZE 65536
+#define CONSOLE_SIZE 4096
+#define AUDIO_SIZE 1024
+#define AUDIO_QUEUE_SAMPLES 512
+
+/* Pointer fields are explicitly 32-bit even on the MEMORY64=2 build.
+ * QEMU is configured with the 32-bit address limit. */
+typedef struct {
+    uint32_t rx_buf, rx_size, tx_buf, tx_size;
+    uint32_t rx_head, rx_tail, tx_head, tx_tail;
+} SerialControl;
+typedef struct {
+    uint32_t buf, size, head, tail;
+} RingControl;
+typedef struct {
+    uint32_t buf, size, head, tail, rate, volume;
+} AudioControl;
+typedef struct {
+    void *opaque;
+    int (*can_read)(void *);
+    void (*receive)(void *, const uint8_t *, int);
+} Receiver;
+
+static uint8_t serial_rx[SERIAL_SIZE], serial_tx[SERIAL_SIZE];
+static uint8_t console_rx[CONSOLE_SIZE];
+static int16_t audio_pcm[AUDIO_SIZE];
+static SerialControl serial_ctrl;
+static RingControl console_ctrl;
+static AudioControl audio_ctrl;
+static Receiver serial_receiver, console_receiver;
+static uint32_t buttons;
+static uint32_t touch_ctrl[4]; /* sequence, down, x, y */
+static uint32_t touch_seen;
+static void *touch_opaque;
+static void (*touch_update)(void *, uint32_t, uint32_t, uint32_t);
+static void *display_opaque;
+static void (*display_update)(void *);
+static uint32_t display_width, display_height, display_stride, display_data;
+static uint32_t display_frames;
+static unsigned poll_count;
+static QEMUTimer *poll_timer;
+
+static void receive_ring(Receiver *r, const uint8_t *buf, uint32_t size,
+                         uint32_t *headp, uint32_t *tailp)
+{
+    if (!r->receive) {
+        return;
+    }
+    uint32_t head = qatomic_load_acquire(headp);
+    uint32_t tail = qatomic_read(tailp);
+    uint32_t avail = head - tail;
+    if (!avail || avail > size) {
+        return;
+    }
+    int room = r->can_read(r->opaque);
+    if (room <= 0) {
+        return;
+    }
+    uint32_t n = MIN(avail, MIN((uint32_t)room, size - tail % size));
+    r->receive(r->opaque, buf + tail % size, n);
+    qatomic_store_release(tailp, tail + n);
+}
+
+static void poll(void *opaque)
+{
+    pbl_gpio_set_button_state(qatomic_read(&buttons));
+    uint32_t seq = qatomic_load_acquire(&touch_ctrl[0]);
+    if (seq != touch_seen && touch_update) {
+        uint32_t down = qatomic_read(&touch_ctrl[1]);
+        uint32_t x = qatomic_read(&touch_ctrl[2]);
+        uint32_t y = qatomic_read(&touch_ctrl[3]);
+        if (seq == qatomic_load_acquire(&touch_ctrl[0])) {
+            touch_seen = seq;
+            touch_update(touch_opaque, down, x, y);
+        }
+    }
+    receive_ring(&serial_receiver, serial_rx, SERIAL_SIZE,
+                 &serial_ctrl.rx_head, &serial_ctrl.rx_tail);
+    receive_ring(&console_receiver, console_rx, CONSOLE_SIZE,
+                 &console_ctrl.head, &console_ctrl.tail);
+    if (++poll_count % 4 == 0 && display_update) {
+        display_update(display_opaque);
+    }
+    timer_mod(poll_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 8);
+}
+
+static void bridge_init(void)
+{
+    if (poll_timer) {
+        return;
+    }
+    serial_ctrl.rx_buf = (uint32_t)(uintptr_t)serial_rx;
+    serial_ctrl.rx_size = SERIAL_SIZE;
+    serial_ctrl.tx_buf = (uint32_t)(uintptr_t)serial_tx;
+    serial_ctrl.tx_size = SERIAL_SIZE;
+    console_ctrl.buf = (uint32_t)(uintptr_t)console_rx;
+    console_ctrl.size = CONSOLE_SIZE;
+    audio_ctrl.buf = (uint32_t)(uintptr_t)audio_pcm;
+    audio_ctrl.size = AUDIO_SIZE;
+    audio_ctrl.rate = 16000;
+    audio_ctrl.volume = 100;
+    poll_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, poll, NULL);
+    timer_mod(poll_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 8);
+}
+
+void pbl_wasm_display_register(void *opaque, void (*update)(void *))
+{
+    bridge_init();
+    display_opaque = opaque;
+    display_update = update;
+}
+
+void pbl_wasm_display_publish(QemuConsole *con, uint32_t width, uint32_t height)
+{
+    DisplaySurface *surface = qemu_console_surface(con);
+    display_width = width;
+    display_height = height;
+    display_stride = surface_stride(surface);
+    display_data = (uint32_t)(uintptr_t)surface_data(surface);
+    qatomic_store_release(&display_frames, display_frames + 1);
+}
+
+void pbl_wasm_touch_register(void *opaque,
+                             void (*update)(void *, uint32_t, uint32_t, uint32_t))
+{
+    bridge_init();
+    touch_opaque = opaque;
+    touch_update = update;
+}
+
+void pbl_wasm_serial_register(void *opaque, int (*can_read)(void *),
+                              void (*receive)(void *, const uint8_t *, int))
+{
+    bridge_init();
+    serial_receiver = (Receiver){opaque, can_read, receive};
+}
+
+void pbl_wasm_console_register(void *opaque, int (*can_read)(void *),
+                               void (*receive)(void *, const uint8_t *, int))
+{
+    bridge_init();
+    console_receiver = (Receiver){opaque, can_read, receive};
+}
+
+int pbl_wasm_serial_write(const uint8_t *buf, int len)
+{
+    uint32_t head = qatomic_read(&serial_ctrl.tx_head);
+    uint32_t tail = qatomic_load_acquire(&serial_ctrl.tx_tail);
+    uint32_t queued = head - tail;
+    if (len < 0 || queued > SERIAL_SIZE || (uint32_t)len > SERIAL_SIZE - queued) {
+        return 0;
+    }
+    for (int i = 0; i < len; i++) {
+        serial_tx[(head + i) % SERIAL_SIZE] = buf[i];
+    }
+    qatomic_store_release(&serial_ctrl.tx_head, head + len);
+    return len;
+}
+
+void pbl_wasm_audio_configure(uint32_t rate, uint32_t volume)
+{
+    bridge_init();
+    qatomic_set(&audio_ctrl.rate, rate ? rate : 16000);
+    qatomic_set(&audio_ctrl.volume, volume);
+}
+
+size_t pbl_wasm_audio_write(const int16_t *samples, size_t count)
+{
+    uint32_t head = qatomic_read(&audio_ctrl.head);
+    uint32_t tail = qatomic_load_acquire(&audio_ctrl.tail);
+    uint32_t queued = head - tail;
+    if (queued >= AUDIO_QUEUE_SAMPLES) {
+        return 0;
+    }
+    /* At most 32 ms at 16 kHz can be queued ahead of WebAudio. A slow or
+     * suspended browser stops acceptance, backpressuring the device IRQs. */
+    count = MIN(count, AUDIO_QUEUE_SAMPLES - queued);
+    for (size_t i = 0; i < count; i++) {
+        audio_pcm[(head + i) % AUDIO_SIZE] = samples[i];
+    }
+    qatomic_store_release(&audio_ctrl.head, head + count);
+    return count;
+}
+
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_display_width(void) { return display_width; }
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_display_height(void) { return display_height; }
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_display_stride(void) { return display_stride; }
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_display_data(void) { return display_data; }
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_display_frame_count(void) { return qatomic_read(&display_frames); }
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_button_state_addr(void) { return (uint32_t)(uintptr_t)&buttons; }
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_touch_ctrl(void) { return (uint32_t)(uintptr_t)touch_ctrl; }
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_serial_ctrl(void) { return (uint32_t)(uintptr_t)&serial_ctrl; }
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_console_ctrl(void) { return (uint32_t)(uintptr_t)&console_ctrl; }
+EMSCRIPTEN_KEEPALIVE uint32_t pebble_wasm_audio_ctrl(void) { return (uint32_t)(uintptr_t)&audio_ctrl; }
+#endif
